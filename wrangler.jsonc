{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "huda-store-admin",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "keep_vars": true,
  "secrets": {
    "required": [
      "GITHUB_CLIENT_SECRET",
      "GITHUB_APP_PRIVATE_KEY",
      "SESSION_SECRET"
    ]
  }
}
